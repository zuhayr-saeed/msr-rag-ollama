<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with pattern -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for persistent logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/graphrag.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/graphrag.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- GraphRAG package logging -->
    <logger name="edu.yourorg.msr.graphrag" level="DEBUG"/>

    <!-- Flink logging -->
    <logger name="org.apache.flink" level="INFO"/>
    
    <!-- Neo4j driver logging -->
    <logger name="org.neo4j.driver" level="WARN"/>
    
    <!-- Akka logging -->
    <logger name="akka" level="INFO"/>
    <logger name="com.typesafe.akka" level="INFO"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

